    {
      "id": 367,
      "description": "Request is server-to-client. Closed is client-to-server for opening failure, user close, or acknowledgement of a server request. Confirmed is server-to-client after inventory work drains. Successful opening sends no acknowledgement.",
      "type": {
        "name": "Virtual Container Close Packet Payload",
        "bind_type": "struct",
        "is_bind_type": true
      }
    },
